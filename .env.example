# OpenRouter key for NEXO AI (set privately in Render Environment)
NEXO_OPENROUTER_KEY=

# Optional: assign the owner role to this username at registration
NEXO_ADMIN=

# Set true only when served over HTTPS
NEXO_SECURE_COOKIES=true

# Optional persistent-disk mount path, e.g. /var/data
NEXO_DATA_DIR=

# Render supplies PORT automatically; do not set it manually there
